# M5Stack Tab5 configuration template.
# Copy this file to sdkconfig.tab5.defaults, then fill in the local Wi-Fi
# credentials and MQTT broker URI. sdkconfig.tab5.defaults is gitignored.

# Tab5 C6 Wi-Fi coprocessor: SDIO slot 1 and power gate.
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
# CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW is not set
CONFIG_MQJS_TAB5_POWER=y

# Local network settings. Replace these values after copying the file.
CONFIG_MQJS_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_MQJS_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"
CONFIG_MQJS_TASK_BROKER="mqtt://192.168.1.2"

# Tab5 display, touch, SSH client, and camera.
CONFIG_MQJS_TAB5_UI=y
CONFIG_MQJS_SSH=y
# Montserrat 20 was the ui_font() fallback that filled Noto's missing
# U+0020/U+0022 and drew the LV_SYMBOL icons. font_term_mono covers both
# since S0, so this is 21.8 KB of dead weight; Montserrat 14 is the chain
# tail now.
# CONFIG_LV_FONT_MONTSERRAT_20 is not set
# Required, not decorative: ui_font() references &lv_font_montserrat_14
# directly (it is the last link of the fallback chain, for U+F55A/U+F8A2).
# It happens to be on via LV_FONT_DEFAULT_MONTSERRAT_14 today, so state it
# explicitly — changing the default font size would otherwise turn this
# into a link error. A loud failure, but an avoidable one.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_MQJS_CAMERA=y

# Camera pipeline (SC2356 over MIPI-CSI).
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_CAMERA_SC202CS=y
# Vendored IPA config: stock esp_ipa 2.1.0 emits an invalid ISP gamma curve
# for sc202cs (per-frame "gamma xcoord error"); our copy drops the gamma block.
CONFIG_CAMERA_SC202CS_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_SC202CS_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH="components/cam_tab5/ipa/sc202cs_ipa.json"
CONFIG_CAMERA_SC202CS_AUTO_DETECT=y
CONFIG_CAMERA_SC202CS_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC202CS_MIPI_RAW8_1280x720_30FPS=y
CONFIG_CAMERA_SC202CS_MIPI_RAW8_1600X1200_30FPS=y
CONFIG_CAMERA_SC202CS_MIPI_DEFAULT_FMT_RAW8_1600X1200_30FPS=y
CONFIG_ESP_IPA_AGC_ALGORITHM=y
CONFIG_ESP_IPA_AGC_THRESHOLD=y
CONFIG_ESP_IPA_AWB_ALGORITHM=y
CONFIG_ESP_IPA_AWB_GRAY_WORLD=y
CONFIG_ESP_IPA_DENOISING_ALGORITHM=y
CONFIG_ESP_IPA_DENOISING_GAIN_FEEDBACK=y
CONFIG_ESP_IPA_SHARPEN_ALGORITHM=y
CONFIG_ESP_IPA_SHARPEN_FREQUENCY_FEEDBACK=y

# HTTPS support for http.get().
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# Speaker playback path (ES8388 + I2S; audio_tab5 component).
CONFIG_MQJS_TAB5_AUDIO=y
# Optional: embed assets/audio/tab5-boot.wav (~1.2 MB) so audio.playWav()
# works without a filesystem. Off by default — it grows every flash.
# CONFIG_MQJS_TAB5_AUDIO_BOOT_WAV=y
# CONFIG_MQJS_TAB5_AUDIO_BOOT_WAV_AUTOPLAY=y

# Optional: decode the embedded 48 kbps Ogg Opus fixture through audio_tab5.
# CONFIG_OPUS_PLAYER=y
# CONFIG_OPUS_PLAYER_BOOT_OPUS=y
# CONFIG_OPUS_PLAYER_BOOT_AUTOPLAY=y

# --- SKK Japanese input -----------------------------------------------
# ONE dictionary in ONE place; menuconfig asks WHERE and WHICH
# separately. Default: SKK-JISYO.ML in the `jisyo` partition, which
# `idf.py flash` writes for you. Both places are mmap'd flash read in
# place, so the search speed is identical — the partition just does not
# compete with the code for the 6 MB app partition, holds up to 8.5 MB,
# and can be rewritten without a firmware rebuild.
#
# Point this at a directory holding SKK-JISYO.{S,M,ML,L} from
# https://github.com/skk-dev/dict and the build prepares the image with
# tools/skk_prep.py (UTF-8 re-sort + full verification). Empty, the
# prepared .bin in components/skk_core/ is used as it is; with neither,
# the build warns, skips, and still succeeds.
# CONFIG_MQJS_SKK_DICT_SOURCE_DIR="../skk-dict"
#
# Where:
# CONFIG_MQJS_SKK_DICT_AT_BUILTIN=y  # in the app image instead. Costs
#                                    # app partition space, needs a full
#                                    # rebuild to change, but skk.open()
#                                    # is 175 us rather than 197 ms (the
#                                    # bootloader already checks it).
# CONFIG_MQJS_SKK_DICT_AT_NONE=y     # no dictionary at all
#
# Which (default M when built in, ML in the partition):
# CONFIG_MQJS_SKK_DICT_S=y   # 3,379 headings, 117 KB
# CONFIG_MQJS_SKK_DICT_M=y   # 8,346 headings, 303 KB
# CONFIG_MQJS_SKK_DICT_L=y   # 175,790 headings, 8.07 MB. Partition only;
#                            # +34 s per flash, skk.open() 826 ms.

# --- size/SRAM diet (perf/size-diet, 2026-07-29) ----------------------
# Flash: drop assert location strings, the esp_err name table, the FULL
# CA bundle (CMN keeps the ~40 common roots), LVGL widgets this UI never
# creates, and SW-render color formats it never draws (all surfaces are
# RGB565; ARGB8888 stays for intermediate layers, A8 for masks). LVGL
# example sources stop being compiled at all.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_ARCLABEL=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_CHECKBOX=n
CONFIG_LV_USE_DROPDOWN=n
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LINE=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n
CONFIG_LV_USE_THEME_SIMPLE=n
CONFIG_LV_DRAW_SW_SUPPORT_RGB565A8=n
CONFIG_LV_DRAW_SW_SUPPORT_RGB888=n
CONFIG_LV_DRAW_SW_SUPPORT_XRGB8888=n
CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888_PREMULTIPLIED=n
CONFIG_LV_DRAW_SW_SUPPORT_L8=n
CONFIG_LV_DRAW_SW_SUPPORT_AL88=n
CONFIG_LV_DRAW_SW_SUPPORT_I1=n
# Internal SRAM: P4 L2MEM is ONE pool (IRAM/DRAM are the same 768 KB),
# so IRAM code moved to flash is heap gained, byte for byte.
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_PERIPH_CTRL_FUNC_IN_IRAM=n
