# ESP-IDF / CMake build outputs
build/
build_*/
**/CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# PC test artifacts (see README "PC でのテスト")
components/mqjs/gen_pc/
# run_pc writes the personal dictionary relative to its cwd (on the
# device it is /littlefs/skk/mru.txt), so running the ssh_vt IME test
# from components/mqjs leaves one behind.
components/mqjs/skk/

# SDK config local artifacts
sdkconfig
sdkconfig.old

# VS Code local workspace settings
.vscode/

# OS/editor artifacts
*.log
*.tmp
.DS_Store
Thumbs.db

# IDF component manager downloads (regenerated from main/idf_component.yml)
managed_components/

# Ed25519 task-signing private key (NEVER commit; public key is in main/task_pubkey.h)
tools/task_signing_key.pem
sdkconfig.tab5*
!sdkconfig.tab5.defaults.example
# Python bytecode caches
**/__pycache__/

# Opus 実験ビルドが吐く完全生成 sdkconfig (1 本 141KB)。再現レシピは
# docs/history/opus-decoder-plan.md、組み合わせる Kconfig 断片は
# sdkconfig.opus/ (アンダースコアを含まないのでここには当たらない)。
sdkconfig.opus_*
build_opus_fixed_prof/*.sdkconfig
build_opus_*_log.txt

# host QR investigation scratch (raw gray corpus)
.qrtmp/

# generated provisioning QR — embeds real Wi-Fi/Tailscale secrets, never commit
docs/qr-test/provision.png

# generated by tools/skk_prep.py: the image embedded into flash rodata,
# and the one `idf.py flash` writes to the `jisyo` partition. Both are
# generated data whose size depends on the dictionary chosen, and the
# source dictionaries carry their own licence terms.
components/skk_core/skk_dict.bin
components/skk_core/skk_jisyo.bin
