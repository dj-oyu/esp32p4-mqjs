CONFIG_IDF_TARGET="esp32p4"
CONFIG_SPIRAM=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# M5Stamp-P4 ships chip revision v1.x; IDF 6.0 defaults to v3.01 (ECO5)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# Custom table: large factory app + LittleFS "storage" for persisted tasks
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# WiFi via Stamp-AddOn C6 (esp-hosted slave over SDIO, esp_wifi_remote on host).
# P4 SDMMC slot 0 has fixed IOMUX pins, so the Stamp wiring needs slot 1
# (GPIO matrix): CLK=43 CMD=44 D0..D3=45..48, C6 reset on GPIO42.
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=43
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=44
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=45
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=46
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=47
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=48
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=42

# Tab5 UI console: break long words anywhere so console lines use the
# full panel width (default 0 moves whole unbreakable words to the next
# line, leaving big right-side gaps). Harmless on Stamp (LVGL unlinked).
CONFIG_LV_TXT_LINE_BREAK_LONG_LEN=6

# LVGL heap (W1-1): builtin tlsf pool whose backing memory comes from
# PSRAM — LV_MEM_POOL_ALLOC is defined to heap_caps_malloc(MALLOC_CAP_SPIRAM)
# on the lvgl target in components/ui_tab5/CMakeLists.txt, so lv_init()
# carves the whole pool out of the 32MB PSRAM at runtime (LV_MEM_ADR can't
# do that: it needs a compile-time address). Widget churn (screens/forms,
# widget-framework-design.md §4①) then never touches scarce internal RAM.
# History: the previous CLIB malloc (internal RAM) was itself a workaround
# for ~200 console labels exhausting the old 64KB builtin pool; the 3MB
# PSRAM pool fixes that for real. Harmless on Stamp (LVGL never inits).
CONFIG_LV_USE_BUILTIN_MALLOC=y
CONFIG_LV_MEM_SIZE_KILOBYTES=3072

# wolfSSL/wolfSSH (components/sshc, pulled unconditionally). These make it
# compile cleanly on BOTH Tab5 and Stamp; the actual SSH client is gated
# by CONFIG_MQJS_SSH (Tab5 only, in sdkconfig.tab5.defaults) and dropped
# by --gc-sections when off, so Stamp flash is unaffected.
#   ENABLE_WOLFSSH: turn on WOLFSSH_TERM etc. in wolfSSL's user_settings.h
#   NO_STACK_SIZE_BUILD_WARNING: silence the RSA-vs-3.5KB-main-stack
#     #warning that -Werror=cpp makes fatal (SSH runs on its own 8KB task)
CONFIG_ESP_ENABLE_WOLFSSH=y
CONFIG_ESP_WOLFSSL_NO_STACK_SIZE_BUILD_WARNING=y

# Keyboard-dock landscape rotation: esp_lvgl_port rotates every flush on
# the PPA (ui_tab5 sets disp flags.sw_rotate). Without this the port
# falls back to a CPU rotate — same extra buffer, much more CPU. Only
# exists on SOC_PPA_SUPPORTED targets (P4); ignored on Stamp.
CONFIG_LVGL_PORT_ENABLE_PPA=y

# Build at -O2 rather than IDF's default -Og. Measured on the Tab5: the
# button/text-heavy UI rasterises ~40% faster per pixel (flat fills are
# memory-bound and unchanged), and GCC's stronger analysis at this level
# found a real format-truncation bug that -Og could not see. Assertions
# stay on; only a fresh sdkconfig picks this up, an existing one keeps
# whatever it already has.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# FATFS のファイル名を UTF-8 でやり取りする (microSD を扱うファイラ用)。
# 既定の ANSI/OEM だと日本語のファイル名がそのまま化ける。LFN が有効なら
# 長い名前は UTF-16 で記録されるので、コードページ (SFN 用) は 437 のまま
# でよい — CP932 のテーブルは数十 KB の flash を食う割に、効くのは LFN を
# 持たない純 8.3 名だけ。実機で化けるカードが出たら CODEPAGE_932 に一行で
# 切り替える。docs/filer-storage-design.md §8。
# Stamp では FATFS を誰も使わないので無害。
CONFIG_FATFS_API_ENCODING_UTF_8=y

# littlefs の読みを mmap 経由にする。read が esp_partition_read (= SPI1 ドライバ
# = 両コアのキャッシュ停止) ではなく memcpy になるので、停止が消える。
#
# 根拠 (実機実測 2026-08-26): ネイティブ・ファイルピッカーの dir_open が
# 4 件で 9.7ms / 7 件で 10.3ms かかっていた。犯人は stat ではなく littlefs の
# メタデータ走査で、lfs_dir_getinfo が 1 件ごとにブロックを 2 回舐め、
# LITTLEFS_READ_SIZE=128 なので走査 1 回 = ⌈使用量/128⌉ 回の flash read。
# flash_stall_meter の差分がそれを裏付けた: ピッカー操作の 31 秒窓で停止
# +502 回、同じ窓の dir_open 合計 33.5ms / 平均停止長 78us = 予測 430 回。
# **dir_open の所要時間はほぼそのまま停止時間だった。**
#
# 書き込みと消去は esp_partition_write / _erase_range のままなので、
# キャッシュ無効化は生きている = XIP (docs/native-editor-design.md §6.3) が
# 抱える「erase 中の mmap 読みが黙って壊れる」危険はここには無い。
# 書き込み後の整合は IDF 6.0.1 の flash_end_flush_cache が見る
# (esp_flash_api.c:276、write :1203/1209、erase :1535/1543)。
#
# 反証可能な予測: これを入れると dir_open は 1ms 未満、dir_open 区間の
# 停止は 0 発になる。ならなければこの因果は間違いなので、別の犯人を探すこと。
CONFIG_LITTLEFS_MMAP_PARTITION=y
